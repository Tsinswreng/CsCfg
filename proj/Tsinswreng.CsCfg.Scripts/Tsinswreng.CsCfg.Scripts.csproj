<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- 各具名腳本的 Main(Root, CancellationToken) 由 Program dispatcher 呼叫；只有 Program.Main 是 CLR entry point。 -->
		<NoWarn>$(NoWarn);CS0028</NoWarn>
		<!-- 腳本只是開發期工具, 不發佈, 故不必 AOT。 -->
		<PublishAot>false</PublishAot>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- 與 TswgCsTpl_Lib / Ngan.Dict / CsSql 的 Scripts 一致, 固定從 NuGet 引用 -->
		<PackageReference Include="Tsinswreng.CsSh" Version="0.3.0-alpha" />
	</ItemGroup>

</Project>
